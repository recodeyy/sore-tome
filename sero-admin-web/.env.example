# ─── SERO Admin Web — environment template (safe to commit) ────────────────────
# Copy to .env.local and fill real values. NEVER commit .env.local.

# Canonical SERO backend base URL (server-side only; used by BFF proxy + SSR).
# The browser never talks to the backend directly — all calls go through
# Next.js route handlers under /app/api/* so tokens/keys stay server-side.
SERO_BACKEND_URL=http://localhost:3001/api/v1

# Public app metadata (safe to expose)
NEXT_PUBLIC_APP_NAME=SERO Control

# ─── AI providers (SERVER-ONLY — never prefixed NEXT_PUBLIC) ───────────────────
# The website proxies AI through the canonical backend /ai/chat by default.
# These are only used if AI_PROXY_MODE=direct (fallback BFF proxy).
AI_PROXY_MODE=backend        # backend | direct
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─── ElevenLabs voice (SERVER-ONLY) ───────────────────────────────────────────
# TTS is proxied through /app/api/voice/tts so the key never reaches the browser.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ─── Session ──────────────────────────────────────────────────────────────────
# Secret used to sign the session cookie wrapper (rotate in prod).
SESSION_SECRET=change-me-in-prod
