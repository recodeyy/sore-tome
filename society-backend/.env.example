# ─── SERVER CONFIG ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ─── FIREBASE CONFIG (No JSON file reliance) ──────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
# Note: In .env, replace actual newlines in private key with \n string
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ─── DATABASE CONFIG (PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/society_db

# ─── REDIS CONFIG ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── PAYMENTS (Razorpay) ──────────────────────────────────────────────────────
# Supply REAL Razorpay TEST keys (from the Razorpay dashboard → Settings → API Keys,
# in Test Mode) to enable the bill→payment→webhook→receipt flow. When these are
# absent the payment endpoints return 503 (feature-disabled) instead of crashing.
# NEVER commit real keys — keep them only in the untracked .env.
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
# Webhook signing secret you set when creating the Razorpay webhook (Settings → Webhooks).
# Validates X-Razorpay-Signature on POST /api/v1/funds/payments/webhook and
# POST /api/v1/finance/webhook/razorpay. Webhooks are rejected (503) when unset.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── UPI DEMO (QR + admin mark-paid; §13) ─────────────────────────────────────
# Backend-controlled payee shown in the demo UPI QR (GET /api/v1/funds/payments/upi-qr).
UPI_DEMO_VPA=sero-demo@upi
UPI_DEMO_NAME=SERO Demo
# The admin-only POST /api/v1/funds/payments/upi-demo/mark-paid endpoint works
# when NODE_ENV != production, OR in production only if this flag is true.
ADMIN_DEMO_MODE=false

# ─── MONITORING ───────────────────────────────────────────────────────────────
SENTRY_DSN=
JWT_SECRET=your-super-secret-jwt-key
